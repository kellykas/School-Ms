{
  "name": "edusphere-school-management",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --noEmit",
    "storage:check": "bun scripts/storage.ts check",
    "backup:export": "bun scripts/backup-export.ts",
    "storage:backup": "bun scripts/backup-export.ts && bun scripts/storage.ts backup",
    "storage:restore": "bun scripts/storage.ts restore"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1134.0",
    "@neondatabase/serverless": "^1.1.0",
    "lucide-react": "^0.561.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
